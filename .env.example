FAMILYOS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/familyos
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FAMILYOS_MASTER_KEY=
FAMILYOS_BLOB_BACKEND=s3
FAMILYOS_S3_BUCKET=familyos-originals
FAMILYOS_S3_ENDPOINT_URL=http://localhost:9000
FAMILYOS_S3_ACCESS_KEY_ID=minioadmin
FAMILYOS_S3_SECRET_ACCESS_KEY=minioadmin
FAMILYOS_INBOUND_DOMAIN=in.familyos.local
FAMILYOS_INBOUND_WEBHOOK_SECRET=change-me
# The authserv-id your mail provider stamps on Authentication-Results, e.g.
# mx.google.com or amazonses.com. Only that provider's verdict is believed;
# unset, every forwarded message waits in quarantine for a guardian.
FAMILYOS_INBOUND_AUTHSERV_ID=

# Extraction. With the API key for the model's provider, notices are read by
# the model; without it, by the offline rule-based extractor. The model is
# provider/model: openai/gpt-5.6-sol or anthropic/claude-opus-5-5.
# rules: notices are read here and their text never leaves this deployment.
# model (or claude / openai): the full text of every accepted notice, names
# included, is sent to that provider. Setting an API key alone does NOT turn
# this on -- it is named here or not at all.
FAMILYOS_EXTRACTOR=rules
FAMILYOS_EXTRACTION_MODEL=openai/gpt-5.6-sol
FAMILYOS_EXTRACTION_EFFORT=medium
# Scripts the OCR should expect, as Tesseract codes joined by "+". English
# alone reads a Devanagari notice as noise rather than as bad English, so a
# deployment serving Hindi-medium schools must say so -- and have the matching
# tesseract-ocr-<lang> package installed.
FAMILYOS_OCR_LANGUAGES=eng
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# An organisation-level Anthropic key needs the workspace it bills to (wrkspc_...);
# leave empty for a key created inside a workspace.
FAMILYOS_ANTHROPIC_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Local testing with your own accounts. Neither CASA nor a verified WhatsApp
# business account is needed for any of this -- see docs/local-credentials.md.
# Placeholders only in this file. Real values go in .env, which is gitignored.
# ---------------------------------------------------------------------------

# Where a sign-in link points. Must be reachable from the browser you open it in.
FAMILYOS_CONSOLE_URL=http://localhost:8000/app/
FAMILYOS_SIGN_IN_LINK_MINUTES=15

# Gmail, in Google Cloud "Testing" mode: up to 100 named test users, no CASA
# review. Refresh tokens expire after 7 days, so a test mailbox reconnects
# weekly -- that is the mode, not a bug.
FAMILYOS_GOOGLE_CLIENT_ID=
FAMILYOS_GOOGLE_CLIENT_SECRET=
FAMILYOS_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/google/callback
# Signing in is a second redirect URI on the same OAuth client. Add both
# to the client in Google Cloud, or the one you leave out fails at the
# callback with redirect_uri_mismatch.
FAMILYOS_GOOGLE_SIGN_IN_REDIRECT_URI=http://localhost:8000/v1/sign-in/google/callback

# WhatsApp Cloud API test number, from the Meta developer app. No business
# verification; messages reach up to 5 recipient numbers you add by hand.
FAMILYOS_WHATSAPP_APP_SECRET=
FAMILYOS_WHATSAPP_VERIFY_TOKEN=
FAMILYOS_WHATSAPP_ACCESS_TOKEN=
FAMILYOS_WHATSAPP_PHONE_NUMBER_ID=
FAMILYOS_WHATSAPP_BUSINESS_NUMBER=
# A reminder is business-initiated, so WhatsApp refuses it as free text unless
# that member messaged the number in the last 24 hours. An approved utility
# template with two slots gets through. Create it in WhatsApp Manager with a
# body like: "{{1}} — {{2}}". Unset, reminders reach recently-active members
# only, and the boot log says so.
FAMILYOS_WHATSAPP_TEMPLATE_NAME=
FAMILYOS_WHATSAPP_TEMPLATE_LANGUAGE=en

# Telegram, offered next to WhatsApp so a family uses the one they already
# have. Setup is a conversation with @BotFather and nothing else: /newbot
# gives the token, and there is no business verification, no approved
# template and no 24-hour window, so reminders are plain text.
#
# The webhook secret is yours to invent -- any 1-256 characters from
# [A-Za-z0-9_-] -- and it is the only thing in front of the inbound URL.
# Register both at once:
#   curl -F url=https://<host>/v1/inbound/telegram \
#        -F secret_token=<the same secret> \
#        https://api.telegram.org/bot<token>/setWebhook
#
# Leave privacy mode ON in BotFather, and do not make the bot a group admin:
# either one makes Telegram send the whole group. FamilyOS refuses that
# traffic regardless, which is the point -- but there is no reason to be
# handed what you will not read.
FAMILYOS_TELEGRAM_BOT_TOKEN=
FAMILYOS_TELEGRAM_WEBHOOK_SECRET=
FAMILYOS_TELEGRAM_BOT_USERNAME=

# Reminders and replies. A local catcher is enough -- see the doc.
FAMILYOS_SMTP_HOST=localhost
FAMILYOS_SMTP_PORT=1025
FAMILYOS_SMTP_STARTTLS=false
FAMILYOS_SMTP_FROM=familyos@localhost

# The Ask window. On by default: it sends what a member may see
# (inbox headlines, dates, to-dos, recurring charges -- never a raw notice) to
# the chat model. FAMILYOS_CHAT_MODEL defaults to the extraction model.
FAMILYOS_ASK_ENABLED=true
FAMILYOS_CHAT_MODEL=

# The Sunday digest: each adult gets the week ahead over Telegram, else
# email, on this weekday (0=Monday .. 6=Sunday) from this hour, household time.
FAMILYOS_DIGEST_ENABLED=true
FAMILYOS_DIGEST_WEEKDAY=6
FAMILYOS_DIGEST_HOUR=8
FAMILYOS_TIMEZONE=Asia/Kolkata

# Write accepted dates to the member's own Google Calendar. Asks for
# calendar.events.owned on connect (sensitive, ordinary verification); a
# mailbox connected before this was on reconnects once to grant it.
FAMILYOS_CALENDAR_WRITE_ENABLED=false

# A research provider for the public web. With "parallel" and its key, a
# plan's options carry evidence (a real page, an excerpt, when it was read)
# and watches can read JavaScript pages. Queries are scrubbed of every
# member's name; nothing of the family's is sent; public pages only.
FAMILYOS_WEB_RESEARCH=
FAMILYOS_PARALLEL_API_KEY=

# A self-hosted Steel browser (steel-dev/steel-browser), for the assisted
# harvest's live view and for sign-in sittings: a member signs in to a site
# themselves in a browser they watch, and what it holds is sealed as a
# session for tasks they approve. Unset: no live view, no sign-ins.
# FAMILYOS_STEEL_URL=http://localhost:3000
# Errands on a site with no runbook, and looks, by the generalist: Anthropic's
# browser toolset over the run's own browser, kept to the site's hosts, every
# click gated and a paying one refused. off | fallback | looks. The model is an
# Anthropic model name; empty uses the chat model when that is Anthropic's.
# FAMILYOS_ERRAND_GENERALIST=fallback
# FAMILYOS_ERRAND_MODEL=claude-sonnet-5-5

# The household's own model, through any OpenAI-compatible server: Ollama on
# this machine (the default address), or a server you run. Named here; the
# Rules card then offers a "Local model" switch, off until a guardian flips
# it. With it on, notices are read and questions answered by this model and
# the family's text does not go to the cloud provider. Errands on sites with
# no runbook need a cloud model and stay off while it is on.
# FAMILYOS_LOCAL_MODEL=qwen3:32b
# FAMILYOS_LOCAL_MODEL_URL=http://localhost:11434/v1
# FAMILYOS_LOCAL_MODEL_KEY=local
# FAMILYOS_LOCAL_MODEL_CONTEXT=32768

# ---- Settings not listed above, with their defaults (added 9 Oct 2026). ----
# Every FamilyOS setting is an environment variable with this prefix; the
# defaults below are what the server uses when a line is absent.
#FAMILYOS_BLOB_DIR=.blobs
#FAMILYOS_S3_REGION=ap-south-1
# Parsing runs PyMuPDF, Pillow and Tesseract over bytes a stranger sent,
# so it runs in a child process with no FAMILYOS_ environment: no master
# key, no database URL, no object-store credentials. Off only for
# development, and the boot log says so loudly when it is.
#FAMILYOS_PARSE_SANDBOX=True
#FAMILYOS_PARSE_TIMEOUT_SECONDS=90.0
#FAMILYOS_PARSE_MEMORY_MB=1024
#FAMILYOS_PARSE_CPU_SECONDS=120
#FAMILYOS_PARSE_MAX_OUTPUT_BYTES=64 * 1024 * 1024
# Where a stronger boundary goes without the caller knowing. For example:
#   FAMILYOS_SANDBOX_CMD="bwrap --unshare-net --unshare-pid --die-with-parent --ro-bind / /"
# A process stops a compromised parser reading our secrets or reaching the
# database. It does not stop outbound network or a kernel escape; this is
# the seam for whatever does.
#FAMILYOS_SANDBOX_CMD=
# Intake limits.
#FAMILYOS_MAX_UPLOAD_BYTES=25 * 1024 * 1024
#FAMILYOS_MAX_EMAIL_BYTES=30 * 1024 * 1024
# An export is built in memory and streamed, never stored, so this is a
# ceiling on one request rather than on a household.
#FAMILYOS_MAX_EXPORT_BYTES=200 * 1024 * 1024
# Forwarding email: <household inbound token>@<inbound_domain>. The mail
# provider posts the raw message to /v1/inbound/email with this secret.
# How long a sign-in token lasts. It slides forward while it is being
# used, so an active session stays signed in and an abandoned one ends.
#FAMILYOS_TOKEN_LIFETIME_DAYS=30
# Watching a public page for a member, through the credential-free class-1
# reader. Off by default: it is the first thing that reaches outward.
#FAMILYOS_WATCHES_ENABLED=False
#FAMILYOS_WATCH_SWEEP_SECONDS=900
#FAMILYOS_CALENDAR_ENABLED=False
#FAMILYOS_CALENDAR_SYNC_SECONDS=1800
# A development bridge for unofficial WhatsApp clients, which can read a
# class group where the Cloud API cannot. Off by default and meant to stay
# that way: those clients break WhatsApp's terms, the ban lands on the
# linked number, and a companion session can read every chat on it.
#FAMILYOS_WHATSAPP_BRIDGE_ENABLED=False
#FAMILYOS_WHATSAPP_BRIDGE_SECRET=
#FAMILYOS_WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
#FAMILYOS_TELEGRAM_API_BASE=https://api.telegram.org
# Quarantine mail whose From address is not authenticated (DMARC, or
# DKIM/SPF aligned) by the receiving provider.
#FAMILYOS_REQUIRE_SENDER_AUTH=True
# Durable jobs (familyos/jobs.py, from Orbit).
#FAMILYOS_JOBS_ENABLED=True
#FAMILYOS_JOB_LEASE_SECONDS=60.0
#FAMILYOS_JOB_MAX_ATTEMPTS=5
#FAMILYOS_JOB_ATTACH_SECONDS=20.0
# Extraction (familyos/extraction). "rules" reads notices in this
# deployment and sends nothing anywhere. "model" sends the full text of
# every accepted notice to the provider of extraction_model, so it is named
# here and never inferred from an API key being present.
# The model is named provider/model, LiteLLM-style.
#FAMILYOS_EXTRACTION_ENABLED=True
#FAMILYOS_ANTHROPIC_API_KEY=
#FAMILYOS_OPENAI_API_KEY=
# Reminders (familyos/reminders.py). One recurring job tells whoever may
# see an obligation, before its date. Lead times are days before, as a
# comma-separated list; 0 means on the day.
#FAMILYOS_REMINDERS_ENABLED=True
#FAMILYOS_REMINDER_LEAD_DAYS=7,1,0
#FAMILYOS_REMINDER_SWEEP_SECONDS=3600.0
#FAMILYOS_REMINDER_MAX_ATTEMPTS=5
# "log" writes the reminder to the application log and the audit trail and
# is the default because it needs nothing configured. "email" needs SMTP.
#FAMILYOS_REMINDER_CHANNEL=log
#FAMILYOS_SMTP_USERNAME=
#FAMILYOS_SMTP_PASSWORD=
# Reconciliation (familyos/reconcile.py). Links a revised notice to the one
# it revises. Always proposed, never applied on its own.
#FAMILYOS_RECONCILIATION_ENABLED=True
# Doing something about a notice. Two kinds only -- reply to the school
# that wrote, and a calendar entry -- and the recipient is derived from the
# notice rather than supplied, so there is no parameter through which a
# message could be addressed anywhere else.
#FAMILYOS_ACTIONS_ENABLED=False
#FAMILYOS_ACTION_MAX_ATTEMPTS=3
#FAMILYOS_ACTION_SWEEP_SECONDS=60
#FAMILYOS_GMAIL_ENABLED=False
#FAMILYOS_GMAIL_POLL_SECONDS=300
# What counts as worth reading. Narrow on purpose: the point is school
# mail, not the member's whole inbox, and every message this does not
# match is one FamilyOS never sees.
# A household's administrative life is not only school. These are the
# words that appear in the subject line of a document somebody has to do
# something about -- medical, utility, insurance, travel, device -- and
# nothing else. Narrow on purpose: this query is the only thing standing
# between a connected mailbox and somebody's work email.
#FAMILYOS_GMAIL_QUERY=has:attachment OR subject:(school OR circular OR notice OR fee OR permission OR consent) OR subject:(appointment OR prescription OR "test result" OR vaccination OR discharge) OR subject:(bill OR invoice OR statement OR premium OR renewal OR "due date" OR receipt) OR subject:(booking OR itinerary OR "e-ticket" OR reservation OR visa OR confirmation) OR subject:(warranty OR "service due" OR maintenance OR delivery) OR subject:(UPI OR debited OR "debit alert" OR "transaction alert" OR "payment received" OR "payment successful" OR paid)
# How far back the first pass reaches. A new connection should bring in
# this term's notices, not a decade of mail.
#FAMILYOS_GMAIL_BACKFILL_DAYS=30
#FAMILYOS_GMAIL_MAX_PER_POLL=25
# The authserv-id on mail Google itself delivered. Mail fetched from a
# member's own mailbox has already passed Google's checks, and this is how
# the stored copy says so.
#FAMILYOS_GOOGLE_AUTHSERV_ID=mx.google.com
