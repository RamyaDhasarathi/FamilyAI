# ─────────────────────────────────────────────────────────────────────────────
# Family OS — Backend Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Family OS
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# ── Server ───────────────────────────────────────────────────────────────────
# Bind to 0.0.0.0 so the phone on the same Wi-Fi can reach the backend.
# Never bind only to 127.0.0.1 in dev unless you are using an emulator with ADB.
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for development. Swap to postgresql+asyncpg://... for production.
DATABASE_URL=sqlite+aiosqlite:///./family_os.db

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_GENERATED_SECRET_DO_NOT_USE_THIS_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Bootstrap admin (used only for the one-time bootstrap command) ────────────
BOOTSTRAP_ADMIN_EMAIL=admin@familyos.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=Family Admin
BOOTSTRAP_FAMILY_NAME=My Family
# One-time token that protects the /auth/bootstrap endpoint.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_BOOTSTRAP_TOKEN

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: mock | openai_compatible
# "mock" returns deterministic responses for development without a running model.
# "openai_compatible" works with OpenAI, Ollama (/v1), vLLM, LM Studio, etc.
LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=60
# Safety: external cloud inference is DISABLED by default.
ENABLE_EXTERNAL_CLOUD_INFERENCE=false

# ── Product Provider ──────────────────────────────────────────────────────────
# Options: real_marketplace (scrapes/grounds live Amazon via connected phone) | development_catalogue
PRODUCT_PROVIDER=real_marketplace

# ── Speech-to-Text ────────────────────────────────────────────────────────────
# Options: disabled | whisper_local
# whisper_local requires the openai-whisper package and a downloaded model.
STT_PROVIDER=disabled
STT_MODEL_PATH=
STT_MODEL_NAME=base
ENABLE_EXTERNAL_SPEECH=false

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# Options: disabled
# A real TTS provider (e.g. local TTS engine) can be added later.
TTS_PROVIDER=disabled

# ── Audio Limits ─────────────────────────────────────────────────────────────
MAX_AUDIO_DURATION_SECONDS=60
MAX_AUDIO_UPLOAD_MB=25

# ── Execution ─────────────────────────────────────────────────────────────────
# Allow the development execution simulator. Set to false in production.
ALLOW_DEVELOPMENT_SIMULATION=true

# ── Qwen Intelligence Mobile-Use Agent ────────────────────────────────────────
# Enables the Qwen-UI-Agent / Qwen2.5-VL mobile execution engine.
# Modes:
#   simulation  - Deterministic visual grounding simulator with normalized coordinates
#   vlm_direct  - Connects to local Qwen-VL endpoint (vLLM / Ollama) with vision
#   adb_bridge  - Connects via ADB over Wi-Fi / USB to dispatch real Android gestures
QWEN_AGENT_ENABLED=true
QWEN_AGENT_MODE=simulation
QWEN_VLM_BASE_URL=http://127.0.0.1:11434/v1
QWEN_VLM_MODEL=qwen2.5-vl:7b
QWEN_VLM_API_KEY=
QWEN_VLM_TIMEOUT_SECONDS=60
# Optional ADB device serial for adb_bridge mode (e.g. 192.168.1.100:5555 or USB serial from 'adb devices'):
ADB_DEVICE_SERIAL=
# Path to ADB executable (bundled in repo tools/platform-tools/adb.exe on Windows):
ADB_BINARY_PATH=


# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all in dev.
# In production, set to the exact origin of your frontend.
CORS_ORIGINS=
