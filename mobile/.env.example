# Copy to .env.local (gitignored) and fill in. Unset, the app runs on its mocks.

# The FamilyOS backend. With the phone on USB, `adb reverse tcp:8000 tcp:8000`
# makes the Mac's port 8000 the phone's localhost:8000. On Wi-Fi instead, use
# the Mac's LAN address (http://192.168.x.x:8000) and start uvicorn with
# --host 0.0.0.0.
EXPO_PUBLIC_FAMILYOS_API=http://localhost:8000

# Signing in: the app sends the email to POST /v1/sign-in/dev, which the backend
# answers only with FAMILYOS_DEV_SIGN_IN=true in its .env (development only).
