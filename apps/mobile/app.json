{
  "expo": {
    "name": "Family OS",
    "slug": "family-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familyos",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.familyos.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Family OS uses the microphone for voice input to the Purchase Agent."
      }
    },
    "android": {
      "package": "com.familyos.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Family OS uses the microphone for voice input to the Purchase Agent."
        }
      ]
    ]
  }
}
