# Backend API Base URL
# - When using USB cable with 'adb reverse tcp:8000 tcp:8000' (RECOMMENDED for zero-config connection):
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# - For physical Android phone on the same Wi-Fi without USB (find your laptop IP via 'ipconfig'):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

# - For Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
